<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 以下（API 26-31）的备份规则，与 data_extraction_rules.xml 保持同一策略：
     禁止本应用数据进入任何备份通道，避免 /data/adb/shso 下的脚本外泄。 -->
<full-backup-content>
    <exclude
        domain="root"
        path="." />
    <exclude
        domain="file"
        path="." />
    <exclude
        domain="database"
        path="." />
    <exclude
        domain="sharedpref"
        path="." />
    <exclude
        domain="external"
        path="." />
</full-backup-content>
