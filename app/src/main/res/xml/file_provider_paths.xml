<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- 只暴露安装暂存目录：installApkViaSystem 的唯一入参就是 cache/install-confirm 下的副本。
         此前另有一行 <external-path name="external" path="." />，那是「无 ROOT 直装 /sdcard 上的
         APK」年代的遗留；现在安装确认弹窗一律先把待装包拷到 cache/install-confirm 并交出该副本，
         调用方拿不到 /sdcard 路径，external-path 已成死配置，留着等于愿意为整个外部存储签发
         content:// URI。按最小权限移除；按整棵 cache 暴露同样不可取（会让应用私有的其它缓存文件
         也可被外部按 URI 读取）。 -->
    <cache-path name="cache" path="install-confirm/" />
    <!-- 「打开方式」共享副本：目标文件（可能位于 /data/adb 等受保护路径）先复制到该目录，
         再以 content:// 交给外部应用。仅暴露此子目录，其余缓存不外露。 -->
    <cache-path name="openwith" path="open-with/" />
</paths>
