<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- windowLightNavigationBar 仅 API 27+ 生效，隔离在 -v27 目录以避免 minSdk 26 上的 NewApi 告警。
         parent 必须显式声明：style 名含点号时 AAPT 会把点号前部分当作隐式 parent。
         style 资源按配置整体择一，不存在跨配置项合并：本目录的 Theme.shso 会**完全取代**
         values/ 下的同名 style，故这里必须复列全部条目，否则 API 27+ 上底色与系统栏设置全部丢失。 -->
    <style name="Theme.shso" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FF0C1626</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
