{
  "extensions": [
    "rb",
    "rake",
    "gemspec",
    "ru"
  ],
  "tokenizer": {
    "root": [
      [
        "\\s+",
        "white"
      ],
      [
        "#.*$",
        "comment"
      ],
      [
        "=begin[\\s\\S]*?=end",
        "comment"
      ],
      [
        "\"(\\\\.|[^\"\\\\])*\"",
        "string"
      ],
      [
        "'(\\\\.|[^'\\\\])*'",
        "string"
      ],
      [
        "[@$][A-Za-z_][A-Za-z0-9_]*|@@[A-Za-z_][A-Za-z0-9_]*",
        "variable"
      ],
      [
        ":[A-Za-z_][A-Za-z0-9_]*",
        "attribute"
      ],
      [
        "(\\battr_accessor\\b|\\battr_reader\\b|\\battr_writer\\b|\\bdefined\\?|\\brequire\\b|\\bensure\\b|\\bmodule\\b|\\brescue\\b|\\breturn\\b|\\bunless\\b|\\bBEGIN\\b|\\balias\\b|\\bbegin\\b|\\bbreak\\b|\\bclass\\b|\\belsif\\b|\\bfalse\\b|\\bretry\\b|\\bsuper\\b|\\bundef\\b|\\buntil\\b|\\bwhile\\b|\\byield\\b|\\bcase\\b|\\belse\\b|\\bnext\\b|\\bredo\\b|\\bself\\b|\\bthen\\b|\\btrue\\b|\\bwhen\\b|\\bEND\\b|\\band\\b|\\bdef\\b|\\bend\\b|\\bfor\\b|\\bnil\\b|\\bnot\\b|\\bdo\\b|\\bif\\b|\\bin\\b|\\bor\\b)",
        "keyword"
      ],
      [
        "\\b(true|false|nil)\\b",
        "constant"
      ],
      [
        "(0[xXbBoO][0-9a-fA-F_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9]+)?)",
        "number"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "identifier"
      ],
      [
        "[{}()\\[\\]]",
        "delimiter"
      ],
      [
        "[=+\\-*/%<>!&|^~?:]+",
        "operator"
      ]
    ]
  }
}
