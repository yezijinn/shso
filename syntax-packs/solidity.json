{
  "extensions": [
    "sol"
  ],
  "tokenizer": {
    "root": [
      [
        "\\s+",
        "white"
      ],
      [
        "/\\*",
        "comment",
        "@comment"
      ],
      [
        "//.*$",
        "comment"
      ],
      [
        "\"(\\\\.|[^\"\\\\])*\"",
        "string"
      ],
      [
        "'(\\\\.|[^'\\\\])*'",
        "string"
      ],
      [
        "\\b(pragma|contract|interface|library|function|modifier|event|struct|enum|mapping|constructor|returns|return|if|else|for|while|do|break|continue|emit|new|delete|require|assert|revert|payable|view|pure|constant|external|public|private|internal|override|virtual|immutable|indexed|anonymous|using|is|import|try|catch)\\b",
        "keyword"
      ],
      [
        "\\b(address|bool|string|bytes|bytes1|bytes4|bytes8|bytes16|bytes32|uint|uint8|uint32|uint64|uint128|uint256|int|int8|int32|int64|int128|int256|fixed|ufixed)\\b",
        "type"
      ],
      [
        "\\b(true|false|msg|block|tx|now|this|super)\\b",
        "constant"
      ],
      [
        "(0[xXbBoO][0-9a-fA-F_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9]+)?)",
        "number"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "identifier"
      ],
      [
        "[{}()\\[\\]]",
        "delimiter"
      ],
      [
        "[=+\\-*/%<>!&|^~?:]+",
        "operator"
      ]
    ],
    "comment": [
      [
        ".*?\\*/",
        "comment",
        "@pop"
      ],
      [
        ".*",
        "comment"
      ]
    ]
  }
}
