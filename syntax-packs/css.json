{
  "extensions": [
    "css"
  ],
  "tokenizer": {
    "root": [
      [
        "\\s+",
        "white"
      ],
      [
        "/\\*",
        "comment",
        "@comment"
      ],
      [
        "\"(\\\\.|[^\"\\\\])*\"",
        "string"
      ],
      [
        "'(\\\\.|[^'\\\\])*'",
        "string"
      ],
      [
        "@[A-Za-z_][A-Za-z0-9_-]*",
        "attribute"
      ],
      [
        "\\b(important|inherit|initial|unset|none|auto)\\b",
        "keyword"
      ],
      [
        "(0[xXbBoO][0-9a-fA-F_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9]+)?)",
        "number"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "identifier"
      ],
      [
        "[{}()\\[\\]]",
        "delimiter"
      ],
      [
        "[=+\\-*/%<>!&|^~?:]+",
        "operator"
      ],
      [
        "[.#][A-Za-z_][A-Za-z0-9_-]*",
        "type"
      ],
      [
        "[A-Za-z-]+(?=\\s*:)",
        "variable"
      ],
      [
        "[{}();:,]",
        "delimiter"
      ]
    ],
    "comment": [
      [
        ".*?\\*/",
        "comment",
        "@pop"
      ],
      [
        ".*",
        "comment"
      ]
    ]
  }
}
