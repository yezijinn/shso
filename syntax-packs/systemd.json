{
  "extensions": [
    "service",
    "socket",
    "timer",
    "mount",
    "target",
    "unit",
    "slice",
    "scope",
    "path",
    "swap"
  ],
  "tokenizer": {
    "root": [
      [
        "\\s+",
        "white"
      ],
      [
        "^\\s*[;#].*$",
        "comment"
      ],
      [
        "\"(\\\\.|[^\"\\\\])*\"",
        "string"
      ],
      [
        "\\b(Description|After|Before|Requires|Wants|Type|ExecStart|ExecStop|ExecReload|Restart|User|Group|WorkingDirectory|Environment|EnvironmentFile|RemainAfterExit|KillMode|LimitNOFILE)\\b",
        "keyword"
      ],
      [
        "(0[xXbBoO][0-9a-fA-F_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9]+)?)",
        "number"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "identifier"
      ],
      [
        "[{}()\\[\\]]",
        "delimiter"
      ],
      [
        "[=+\\-*/%<>!&|^~?:]+",
        "operator"
      ],
      [
        "^\\[[^\\]]*\\]",
        "type"
      ]
    ]
  }
}
