{
  "extensions": [
    "gitconfig",
    "gitattributes",
    "gitignore",
    "gitmodules"
  ],
  "tokenizer": {
    "root": [
      [
        "\\s+",
        "white"
      ],
      [
        "#.*$",
        "comment"
      ],
      [
        "\"(\\\\.|[^\"\\\\])*\"",
        "string"
      ],
      [
        "\\b(core|user|remote|branch|alias|push|pull|merge|rebase|diff|color|status|fetch|filter|include|if|hasconfig)\\b",
        "keyword"
      ],
      [
        "(0[xXbBoO][0-9a-fA-F_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9]+)?)",
        "number"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "identifier"
      ],
      [
        "[{}()\\[\\]]",
        "delimiter"
      ],
      [
        "[=+\\-*/%<>!&|^~?:]+",
        "operator"
      ],
      [
        "^\\[[^\\]]*\\]",
        "type"
      ],
      [
        "^\\s*[-+!*/]",
        "operator"
      ]
    ]
  }
}
