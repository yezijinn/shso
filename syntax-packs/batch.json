{
  "extensions": [
    "bat",
    "cmd"
  ],
  "ignoreCase": true,
  "tokenizer": {
    "root": [
      [
        "\\s+",
        "white"
      ],
      [
        "^\\s*(REM|rem)\\s.*$",
        "comment"
      ],
      [
        "^\\s*::.*$",
        "comment"
      ],
      [
        "\"(\\\\.|[^\"\\\\])*\"",
        "string"
      ],
      [
        "%[A-Za-z_][A-Za-z0-9_]*%|![A-Za-z_][A-Za-z0-9_]*!",
        "variable"
      ],
      [
        "\\b(if|else|for|in|do|call|goto|set|setlocal|endlocal|exit|echo|off|on|not|exist|defined|start|cd|copy|move|del|ren|md|rd|pushd|popd|shift|pause|title)\\b",
        "keyword"
      ],
      [
        "\\b(true|false)\\b",
        "constant"
      ],
      [
        "(0[xXbBoO][0-9a-fA-F_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9]+)?)",
        "number"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "identifier"
      ],
      [
        "[{}()\\[\\]]",
        "delimiter"
      ],
      [
        "[=+\\-*/%<>!&|^~?:]+",
        "operator"
      ]
    ]
  }
}
