{
  "extensions": [
    "rs"
  ],
  "tokenizer": {
    "root": [
      [
        "\\s+",
        "white"
      ],
      [
        "/\\*",
        "comment",
        "@comment"
      ],
      [
        "//.*$",
        "comment"
      ],
      [
        "\"(\\\\.|[^\"\\\\])*\"",
        "string"
      ],
      [
        "'(\\\\.|[^'\\\\])?'",
        "string"
      ],
      [
        "#!?\\[[^\\]]*\\]",
        "attribute"
      ],
      [
        "\\b(as|async|await|break|const|continue|crate|dyn|else|enum|extern|false|for|fn|if|impl|in|let|loop|match|mod|move|mut|pub|ref|return|self|Self|static|struct|super|trait|true|type|unsafe|use|where|while|union|box)\\b",
        "keyword"
      ],
      [
        "\\b(i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f32|f64|bool|char|str|String|Vec|Option|Result|Box|Rc|Arc|HashMap|HashSet|RefCell|Cow)\\b",
        "type"
      ],
      [
        "\\b(true|false|None|Some|Ok|Err)\\b",
        "constant"
      ],
      [
        "(0[xXbBoO][0-9a-fA-F_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9]+)?)",
        "number"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "identifier"
      ],
      [
        "[{}()\\[\\]]",
        "delimiter"
      ],
      [
        "[=+\\-*/%<>!&|^~?:]+",
        "operator"
      ]
    ],
    "comment": [
      [
        ".*?\\*/",
        "comment",
        "@pop"
      ],
      [
        ".*",
        "comment"
      ]
    ]
  }
}
