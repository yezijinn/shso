{
  "extensions": [
    "nim",
    "nims",
    "nimble"
  ],
  "tokenizer": {
    "root": [
      [
        "\\s+",
        "white"
      ],
      [
        "#.*$",
        "comment"
      ],
      [
        "\"(\\\\.|[^\"\\\\])*\"",
        "string"
      ],
      [
        "\\b(proc|func|method|macro|template|iterator|converter|var|let|const|type|if|elif|else|case|of|while|for|try|except|finally|raise|defer|discard|when|import|include|export|from|as|do|block|object|enum|tuple|ref|ptr|addr|distinct|concept|static|generic|bind|mixin|use)\\b",
        "keyword"
      ],
      [
        "\\b(int|int8|int16|int32|int64|uint|uint8|uint16|uint32|uint64|float|float32|float64|bool|char|string|seq|array|set|auto|void)\\b",
        "type"
      ],
      [
        "\\b(true|false|nil|result|self)\\b",
        "constant"
      ],
      [
        "(0[xXbBoO][0-9a-fA-F_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9]+)?)",
        "number"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "identifier"
      ],
      [
        "[{}()\\[\\]]",
        "delimiter"
      ],
      [
        "[=+\\-*/%<>!&|^~?:]+",
        "operator"
      ]
    ]
  }
}
