{
  "extensions": [
    "sas"
  ],
  "ignoreCase": true,
  "tokenizer": {
    "root": [
      [
        "\\s+",
        "white"
      ],
      [
        "\\*[^;]*;",
        "comment"
      ],
      [
        "/\\*[\\s\\S]*?\\*/",
        "comment"
      ],
      [
        "\"(\\\\.|[^\"\\\\])*\"",
        "string"
      ],
      [
        "'(\\\\.|[^'\\\\])*'",
        "string"
      ],
      [
        "\\b(data|proc|run|quit|options|libname|filename|set|merge|by|var|input|cards|datalines|output|drop|keep|if|then|else|do|end|array|retain|length|format|informat|label|attrib|where)\\b",
        "keyword"
      ],
      [
        "\\b(numeric|character|date)\\b",
        "type"
      ],
      [
        "(0[xXbBoO][0-9a-fA-F_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9]+)?)",
        "number"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "identifier"
      ],
      [
        "[{}()\\[\\]]",
        "delimiter"
      ],
      [
        "[=+\\-*/%<>!&|^~?:]+",
        "operator"
      ]
    ]
  }
}
