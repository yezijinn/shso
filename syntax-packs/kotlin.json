{
  "extensions": [
    "kt",
    "kts"
  ],
  "tokenizer": {
    "root": [
      [
        "\\s+",
        "white"
      ],
      [
        "/\\*",
        "comment",
        "@comment"
      ],
      [
        "//.*$",
        "comment"
      ],
      [
        "\"(\\\\.|[^\"\\\\])*\"",
        "string"
      ],
      [
        "'(\\\\.|[^'\\\\])?'",
        "string"
      ],
      [
        "@[A-Za-z_][A-Za-z0-9_.]*",
        "attribute"
      ],
      [
        "(\\bconstructor\\b|\\bcrossinline\\b|\\binterface\\b|\\btypealias\\b|\\bcompanion\\b|\\bprotected\\b|\\bcontinue\\b|\\binternal\\b|\\boverride\\b|\\babstract\\b|\\blateinit\\b|\\bnoinline\\b|\\bpackage\\b|\\bfinally\\b|\\bprivate\\b|\\bsuspend\\b|\\breified\\b|\\bobject\\b|\\breturn\\b|\\btypeof\\b|\\bimport\\b|\\bsealed\\b|\\bpublic\\b|\\binline\\b|\\bexpect\\b|\\bactual\\b|\\bbreak\\b|\\bclass\\b|\\bfalse\\b|\\bsuper\\b|\\bthrow\\b|\\bwhile\\b|\\bcatch\\b|\\binner\\b|\\bfinal\\b|\\belse\\b|\\bnull\\b|\\bthis\\b|\\btrue\\b|\\bwhen\\b|\\binit\\b|\\bdata\\b|\\benum\\b|\\bopen\\b|\\bas\\?|\\bfor\\b|\\bfun\\b|!in\\b|!is\\b|\\btry\\b|\\bval\\b|\\bvar\\b|\\bas\\b|\\bdo\\b|\\bif\\b|\\bin\\b|\\bis\\b|\\bby\\b)",
        "keyword"
      ],
      [
        "\\b(Byte|Short|Int|Long|Float|Double|Char|Boolean|String|Unit|Any|Nothing|List|MutableList|Map|MutableMap|Set|MutableSet|Array|IntArray|LongArray|Sequence|Iterable|Comparator|Result)\\b",
        "type"
      ],
      [
        "\\b(true|false|null|Unit)\\b",
        "constant"
      ],
      [
        "(0[xXbBoO][0-9a-fA-F_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9]+)?)",
        "number"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "identifier"
      ],
      [
        "[{}()\\[\\]]",
        "delimiter"
      ],
      [
        "[=+\\-*/%<>!&|^~?:]+",
        "operator"
      ]
    ],
    "comment": [
      [
        ".*?\\*/",
        "comment",
        "@pop"
      ],
      [
        ".*",
        "comment"
      ]
    ]
  }
}
