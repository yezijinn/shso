{
  "extensions": [
    "cpp",
    "cc",
    "cxx",
    "c++",
    "hpp",
    "hh",
    "hxx",
    "h",
    "h++",
    "ino",
    "tcc"
  ],
  "tokenizer": {
    "root": [
      [
        "\\s+",
        "white"
      ],
      [
        "/\\*",
        "comment",
        "@comment"
      ],
      [
        "//.*$",
        "comment"
      ],
      [
        "^\\s*#\\s*[A-Za-z_]+",
        "attribute"
      ],
      [
        "\"(\\\\.|[^\"\\\\])*\"",
        "string"
      ],
      [
        "'(\\\\.|[^'\\\\])?'",
        "string"
      ],
      [
        "\\b(if|else|for|while|do|switch|case|default|break|continue|return|goto|sizeof|typedef|struct|union|enum|static|extern|const|volatile|inline|register|restrict|alignof|asm|noexcept|constexpr|decltype|static_cast|dynamic_cast|reinterpret_cast|const_cast|new|delete|this|try|catch|throw|template|typename|class|public|private|protected|virtual|override|final|friend|operator|namespace|using|explicit|mutable|thread_local|concept|requires|co_await|co_yield|co_return)\\b",
        "keyword"
      ],
      [
        "\\b(void|bool|char|short|int|long|float|double|unsigned|signed|wchar_t|char8_t|char16_t|char32_t|int8_t|int16_t|int32_t|int64_t|uint8_t|uint16_t|uint32_t|uint64_t|size_t|ssize_t|ptrdiff_t|intptr_t|uintptr_t|auto|string|wstring|vector|map|set|unordered_map|unordered_set|shared_ptr|unique_ptr|array|deque|list|pair|tuple|optional|variant|any|function|std)\\b",
        "type"
      ],
      [
        "\\b(true|false|nullptr|NULL|NULLPTR|stdin|stdout|stderr)\\b",
        "constant"
      ],
      [
        "(0[xXbBoO][0-9a-fA-F_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9]+)?)",
        "number"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "identifier"
      ],
      [
        "[{}()\\[\\]]",
        "delimiter"
      ],
      [
        "[=+\\-*/%<>!&|^~?:]+",
        "operator"
      ]
    ],
    "comment": [
      [
        ".*?\\*/",
        "comment",
        "@pop"
      ],
      [
        ".*",
        "comment"
      ]
    ]
  }
}
