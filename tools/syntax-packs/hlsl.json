{
  "extensions": [
    "hlsl",
    "hlslinc",
    "fx",
    "fxh",
    "cginc",
    "usf",
    "ush"
  ],
  "tokenizer": {
    "root": [
      [
        "\\s+",
        "white"
      ],
      [
        "/\\*",
        "comment",
        "@comment"
      ],
      [
        "//.*$",
        "comment"
      ],
      [
        "^\\s*#\\s*[A-Za-z_]+",
        "attribute"
      ],
      [
        "\"(\\\\.|[^\"\\\\])*\"",
        "string"
      ],
      [
        "\\b(cbuffer|register|packoffset|struct|return|if|else|for|while|do|break|continue|discard|inline|static|const|uniform|sampler|texture)\\b",
        "keyword"
      ],
      [
        "\\b(float|float2|float3|float4|half|half2|half3|half4|int|int2|int3|int4|uint|uint2|uint3|uint4|bool|bool2|bool3|bool4|matrix|float4x4|sampler2D|Texture2D|SamplerState|void)\\b",
        "type"
      ],
      [
        "\\b(true|false)\\b",
        "constant"
      ],
      [
        "(0[xXbBoO][0-9a-fA-F_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9]+)?)",
        "number"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "identifier"
      ],
      [
        "[{}()\\[\\]]",
        "delimiter"
      ],
      [
        "[=+\\-*/%<>!&|^~?:]+",
        "operator"
      ]
    ],
    "comment": [
      [
        ".*?\\*/",
        "comment",
        "@pop"
      ],
      [
        ".*",
        "comment"
      ]
    ]
  }
}
