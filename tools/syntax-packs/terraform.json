{
  "extensions": [
    "tf",
    "tfvars",
    "hcl",
    "tfstate"
  ],
  "tokenizer": {
    "root": [
      [
        "\\s+",
        "white"
      ],
      [
        "#.*$",
        "comment"
      ],
      [
        "/\\*[\\s\\S]*?\\*/",
        "comment"
      ],
      [
        "\"(\\\\.|[^\"\\\\])*\"",
        "string"
      ],
      [
        "\\$\\{[^}]*\\}",
        "variable"
      ],
      [
        "\\b(resource|variable|output|module|provider|data|terraform|locals|backend|true|false|null|for_each|count|depends_on|lifecycle|if|for|in)\\b",
        "keyword"
      ],
      [
        "(0[xXbBoO][0-9a-fA-F_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9]+)?)",
        "number"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "identifier"
      ],
      [
        "[{}()\\[\\]]",
        "delimiter"
      ],
      [
        "[=+\\-*/%<>!&|^~?:]+",
        "operator"
      ],
      [
        "^\\s*[A-Za-z_][A-Za-z0-9_-]*(?=\\s*=\\s*\\{)",
        "type"
      ]
    ]
  }
}
