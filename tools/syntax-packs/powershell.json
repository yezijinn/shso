{
  "extensions": [
    "ps1",
    "psm1",
    "psd1"
  ],
  "ignoreCase": true,
  "tokenizer": {
    "root": [
      [
        "\\s+",
        "white"
      ],
      [
        "#.*$",
        "comment"
      ],
      [
        "<#[\\s\\S]*?#>",
        "comment"
      ],
      [
        "\"(\\\\.|[^\"\\\\])*\"",
        "string"
      ],
      [
        "'(\\\\.|[^'\\\\])*'",
        "string"
      ],
      [
        "\\$[A-Za-z_][A-Za-z0-9_]*",
        "variable"
      ],
      [
        "\\[[A-Za-z_][A-Za-z0-9_.*]*\\]",
        "attribute"
      ],
      [
        "\\b(function|param|begin|process|end|if|else|elseif|for|foreach|while|do|until|switch|break|continue|return|try|catch|finally|throw|exit|filter|in|pipe)\\b",
        "keyword"
      ],
      [
        "\\b(true|false|null)\\b",
        "constant"
      ],
      [
        "(0[xXbBoO][0-9a-fA-F_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9]+)?)",
        "number"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "identifier"
      ],
      [
        "[{}()\\[\\]]",
        "delimiter"
      ],
      [
        "[=+\\-*/%<>!&|^~?:]+",
        "operator"
      ]
    ]
  }
}
