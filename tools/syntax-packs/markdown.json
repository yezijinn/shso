{
  "extensions": [
    "md",
    "markdown",
    "mdown"
  ],
  "tokenizer": {
    "root": [
      [
        "\\s+",
        "white"
      ],
      [
        "^#{1,6}\\s.*$",
        "type"
      ],
      [
        "^\\s*[-*+]\\s",
        "delimiter"
      ],
      [
        "^\\s*>\\s.*$",
        "comment"
      ],
      [
        "```[\\s\\S]*?```",
        "string"
      ],
      [
        "`[^`]*`",
        "string"
      ],
      [
        "\\*\\*[^*]+\\*\\*",
        "constant"
      ],
      [
        "(0[xXbBoO][0-9a-fA-F_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9]+)?)",
        "number"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "identifier"
      ],
      [
        "[{}()\\[\\]]",
        "delimiter"
      ],
      [
        "[=+\\-*/%<>!&|^~?:]+",
        "operator"
      ]
    ]
  }
}
