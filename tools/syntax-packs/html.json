{
  "extensions": [
    "html",
    "htm",
    "xhtml",
    "vue",
    "svelte"
  ],
  "tokenizer": {
    "root": [
      [
        "\\s+",
        "white"
      ],
      [
        "<!--[\\s\\S]*?-->",
        "comment"
      ],
      [
        "<[!?][^>]*>",
        "attribute"
      ],
      [
        "</?[A-Za-z_][A-Za-z0-9_.:-]*",
        "type"
      ],
      [
        "\"(\\\\.|[^\"\\\\])*\"",
        "string"
      ],
      [
        "'(\\\\.|[^'\\\\])*'",
        "string"
      ],
      [
        "(0[xXbBoO][0-9a-fA-F_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9]+)?)",
        "number"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "identifier"
      ],
      [
        "[{}()\\[\\]]",
        "delimiter"
      ],
      [
        "[=+\\-*/%<>!&|^~?:]+",
        "operator"
      ],
      [
        ">",
        "type"
      ]
    ]
  }
}
