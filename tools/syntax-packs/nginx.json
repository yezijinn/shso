{
  "extensions": [
    "nginx",
    "nginxconf"
  ],
  "tokenizer": {
    "root": [
      [
        "\\s+",
        "white"
      ],
      [
        "#.*$",
        "comment"
      ],
      [
        "\"(\\\\.|[^\"\\\\])*\"",
        "string"
      ],
      [
        "'(\\\\.|[^'\\\\])*'",
        "string"
      ],
      [
        "\\$[A-Za-z_][A-Za-z0-9_]*",
        "variable"
      ],
      [
        "\\b(server|location|listen|server_name|root|index|proxy_pass|include|upstream|rewrite|return|try_files|if|set|client_max_body_size|access_log|error_log|gzip|ssl_certificate|ssl_certificate_key)\\b",
        "keyword"
      ],
      [
        "(0[xXbBoO][0-9a-fA-F_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9]+)?)",
        "number"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "identifier"
      ],
      [
        "[{}()\\[\\]]",
        "delimiter"
      ],
      [
        "[=+\\-*/%<>!&|^~?:]+",
        "operator"
      ]
    ]
  }
}
