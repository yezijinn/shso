{
  "extensions": [
    "jl"
  ],
  "tokenizer": {
    "root": [
      [
        "\\s+",
        "white"
      ],
      [
        "#.*$",
        "comment"
      ],
      [
        "#=[\\s\\S]*?=]#",
        "comment"
      ],
      [
        "\"(\\\\.|[^\"\\\\])*\"",
        "string"
      ],
      [
        "'(\\\\.|[^'\\\\])?'",
        "string"
      ],
      [
        "@[A-Za-z_][A-Za-z0-9_.]*",
        "attribute"
      ],
      [
        "\\b(function|macro|module|baremodule|using|import|export|struct|mutable|struct|abstract|type|primitive|const|global|local|let|if|elseif|else|for|while|do|begin|try|catch|finally|return|break|continue|end|in|where|quote|begin)\\b",
        "keyword"
      ],
      [
        "\\b(Int|Int8|Int16|Int32|Int64|UInt|UInt8|UInt16|UInt32|UInt64|Float16|Float32|Float64|Bool|Char|String|Array|Vector|Matrix|Dict|Tuple|Any|Nothing)\\b",
        "type"
      ],
      [
        "\\b(true|false|nothing|missing|self)\\b",
        "constant"
      ],
      [
        "(0[xXbBoO][0-9a-fA-F_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9]+)?)",
        "number"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "identifier"
      ],
      [
        "[{}()\\[\\]]",
        "delimiter"
      ],
      [
        "[=+\\-*/%<>!&|^~?:]+",
        "operator"
      ]
    ]
  }
}
