{
  "extensions": [
    "tex",
    "latex",
    "cls",
    "sty",
    "bib",
    "aux"
  ],
  "tokenizer": {
    "root": [
      [
        "\\s+",
        "white"
      ],
      [
        "%.*$",
        "comment"
      ],
      [
        "\\\\[A-Za-z]+",
        "attribute"
      ],
      [
        "(0[xXbBoO][0-9a-fA-F_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9]+)?)",
        "number"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "identifier"
      ],
      [
        "[{}()\\[\\]]",
        "delimiter"
      ],
      [
        "[=+\\-*/%<>!&|^~?:]+",
        "operator"
      ],
      [
        "\\$[^$]*\\$",
        "string"
      ],
      [
        "[{}\\[\\]]",
        "delimiter"
      ]
    ]
  }
}
