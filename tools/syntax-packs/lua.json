{
  "extensions": [
    "lua"
  ],
  "tokenizer": {
    "root": [
      [
        "\\s+",
        "white"
      ],
      [
        "--\\[\\[[\\s\\S]*?\\]\\]",
        "comment"
      ],
      [
        "--.*$",
        "comment"
      ],
      [
        "\"(\\\\.|[^\"\\\\])*\"",
        "string"
      ],
      [
        "'(\\\\.|[^'\\\\])*'",
        "string"
      ],
      [
        "\\b(and|break|do|else|elseif|end|false|for|function|goto|if|in|local|nil|not|or|repeat|return|then|true|until|while)\\b",
        "keyword"
      ],
      [
        "\\b(self|_G|print|pairs|ipairs|require|type|tostring|tonumber)\\b",
        "constant"
      ],
      [
        "(0[xXbBoO][0-9a-fA-F_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9]+)?)",
        "number"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "identifier"
      ],
      [
        "[{}()\\[\\]]",
        "delimiter"
      ],
      [
        "[=+\\-*/%<>!&|^~?:]+",
        "operator"
      ]
    ]
  }
}
