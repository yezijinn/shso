{
  "extensions": [
    "py",
    "pyi",
    "pyw",
    "pyx"
  ],
  "tokenizer": {
    "root": [
      [
        "\\s+",
        "white"
      ],
      [
        "#.*$",
        "comment"
      ],
      [
        "[rRbBuUfF]{0,2}\"\"\"[\\s\\S]*?\"\"\"",
        "string"
      ],
      [
        "[rRbBuUfF]{0,2}'''[\\s\\S]*?'''",
        "string"
      ],
      [
        "[rRbBuUfF]{0,2}\"(\\\\.|[^\"\\\\])*\"",
        "string"
      ],
      [
        "[rRbBuUfF]{0,2}'(\\\\.|[^'\\\\])*'",
        "string"
      ],
      [
        "\"\"\"(\\\\.|[^\"\"\"\\\\])*\"\"\"",
        "string"
      ],
      [
        "'''(\\\\.|[^'''\\\\])*'''",
        "string"
      ],
      [
        "\"(\\\\.|[^\"\\\\])*\"",
        "string"
      ],
      [
        "'(\\\\.|[^'\\\\])*'",
        "string"
      ],
      [
        "@[A-Za-z_][A-Za-z0-9_.]*",
        "attribute"
      ],
      [
        "\\b(and|as|assert|async|await|break|class|continue|def|del|elif|else|except|finally|for|from|global|if|import|in|is|lambda|nonlocal|not|or|pass|raise|return|try|while|with|yield|match|case)\\b",
        "keyword"
      ],
      [
        "\\b(int|float|str|bool|bytes|list|dict|set|tuple|frozenset|complex|type|object)\\b",
        "type"
      ],
      [
        "\\b(True|False|None|self|cls|print|len|range|enumerate|zip|map|filter|open|super|isinstance)\\b",
        "constant"
      ],
      [
        "(0[xXbBoO][0-9a-fA-F_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9]+)?)",
        "number"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "identifier"
      ],
      [
        "[{}()\\[\\]]",
        "delimiter"
      ],
      [
        "[=+\\-*/%<>!&|^~?:]+",
        "operator"
      ]
    ]
  }
}
