{
  "extensions": [
    "ini",
    "conf",
    "cfg",
    "properties",
    "reg",
    "desktop"
  ],
  "ignoreCase": true,
  "tokenizer": {
    "root": [
      [
        "\\s+",
        "white"
      ],
      [
        "^\\s*[;#].*$",
        "comment"
      ],
      [
        "\"(\\\\.|[^\"\\\\])*\"",
        "string"
      ],
      [
        "(0[xXbBoO][0-9a-fA-F_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9]+)?)",
        "number"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "identifier"
      ],
      [
        "[{}()\\[\\]]",
        "delimiter"
      ],
      [
        "[=+\\-*/%<>!&|^~?:]+",
        "operator"
      ],
      [
        "^\\[[^\\]]*\\]",
        "type"
      ],
      [
        "^\\s*[A-Za-z_][A-Za-z0-9_.-]*(?=\\s*=)",
        "variable"
      ],
      [
        "=",
        "operator"
      ]
    ]
  }
}
