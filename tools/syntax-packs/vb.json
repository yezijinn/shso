{
  "extensions": [
    "vb",
    "vbs",
    "bas"
  ],
  "ignoreCase": true,
  "tokenizer": {
    "root": [
      [
        "\\s+",
        "white"
      ],
      [
        "'.*$",
        "comment"
      ],
      [
        "\"(\\\\.|[^\"\\\\])*\"",
        "string"
      ],
      [
        "\\b(if|then|else|elseif|end|if|for|each|next|do|while|loop|until|select|case|sub|function|dim|as|set|let|call|exit|byval|byref|public|private|dim|const|new|nothing|true|false|and|or|not|xor)\\b",
        "keyword"
      ],
      [
        "\\b(True|False|Nothing)\\b",
        "constant"
      ],
      [
        "(0[xXbBoO][0-9a-fA-F_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9]+)?)",
        "number"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "identifier"
      ],
      [
        "[{}()\\[\\]]",
        "delimiter"
      ],
      [
        "[=+\\-*/%<>!&|^~?:]+",
        "operator"
      ]
    ]
  }
}
